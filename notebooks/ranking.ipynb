cur = conn.cursor()

# 1. Busca ordenado por score_final
cur.execute("""
    SELECT cd_desempenho, score_final
    FROM desempenho
    ORDER BY score_final DESC
""")

resultados = cur.fetchall()

# 2. Atualiza o ranking
for posicao, (cd_desempenho, score_final) in enumerate(resultados, start=1):
    cur.execute("""
        UPDATE desempenho
        SET ranking = %s
        WHERE cd_desempenho = %s
    """, (posicao, cd_desempenho))

conn.commit()
print(f"Ranking atualizado para {len(resultados)} deputados!")

cur.close()
conn.close()
