try:
    # Query que calcula a média por deputado e atualiza diretamente a tabela desempenho
    query_atualizar_medias = """
        UPDATE Lumina2.desempenho d
        INNER JOIN (
            SELECT
                fk_deputado,
                AVG(score_projetos) AS media_calculada
            FROM Lumina2.proposicao_deputados
            WHERE fk_deputado IS NOT NULL
            GROUP BY fk_deputado
        ) m ON d.fk_deputado = m.fk_deputado
        SET d.score_projetos = m.media_calculada;
    """

    print("📊 Calculando as médias e atualizando a tabela desempenho...")
    cursor.execute(query_atualizar_medias)
    linhas_afetadas = cursor.rowcount
    conn.commit()

    print(f" Sucesso! Médias de projetos gravadas para {linhas_afetadas} deputados na tabela desempenho.")

except mysql.connector.Error as erro:
    print(f" [ERRO DE BANCO DE DADOS]: {erro}")
    conn.rollback()
except Exception as e:
    print(f" [ERRO NO SCRIPT]: {e}")
