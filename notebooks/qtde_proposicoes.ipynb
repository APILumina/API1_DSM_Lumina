cursor = conn.cursor()

query_contagem = """
    SELECT
        fk_deputado,
        COUNT(fk_deputado) AS total_projetos
    FROM proposicao_deputados
    WHERE fk_deputado IS NOT NULL
    GROUP BY fk_deputado
"""

print("Executando a contagem de frequência de fk_deputado...")
cursor.execute(query_contagem)
resultados_contagem = cursor.fetchall()

query_update_qtde = "UPDATE desempenho SET qtde_proposicoes = %s WHERE fk_deputado = %s"

lote_updates = []
for fk_deputado, total_projetos in resultados_contagem:
    lote_updates.append((int(total_projetos), fk_deputado))

if lote_updates:
    print(f"Atualizando a volumetria de {len(lote_updates)} deputados na tabela desempenho...")
    cursor.executemany(query_update_qtde, lote_updates)

conn.commit()
cursor.close()

print("Coluna qtde_proposicoes atualizada com base na contagem de ocorrências de fk_deputado!")
