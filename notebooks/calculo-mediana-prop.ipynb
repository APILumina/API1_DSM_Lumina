# CÁLCULO DA MEDIANA DE PROPOSIÇÕES

try:
    cursor.close()
except Exception:
    pass

cursor = conn.cursor(buffered=True)

try:
    query_proposicoes = "SELECT qtde_proposicoes FROM Lumina2.desempenho WHERE qtde_proposicoes IS NOT NULL;"
    cursor.execute(query_proposicoes)

    lista_proposicoes = [linha[0] for linha in cursor.fetchall()]

    if lista_proposicoes:
        quantidade_deputados = len(lista_proposicoes)
        media_prop = sum(lista_proposicoes) / quantidade_deputados

        # Cálculo da Mediana
        lista_ordenada = sorted(lista_proposicoes)
        meio = quantidade_deputados // 2
        if quantidade_deputados % 2 == 0:
            mediana_prop = (lista_ordenada[meio - 1] + lista_ordenada[meio]) / 2
        else:
            mediana_prop = lista_ordenada[meio]

        print(f"Total de deputados analisados: {quantidade_deputados}")
        print(f"Mínimo de projetos propostos: {min(lista_proposicoes)}")
        print(f"Máximo de projetos propostos: {max(lista_proposicoes)}")
        print(f"Média de proposições:         {media_prop:.2f}")
        print(f"Mediana de proposições (Alvo): {mediana_prop:.2f}")
    else:
        print("Nenhuma informação de qtde_proposicoes encontrada na tabela desempenho.")

except mysql.connector.Error as erro:
    print(f"Erro ao acessar o banco: {erro}")
finally:
    cursor.close()
