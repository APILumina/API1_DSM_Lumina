# PROPOSIÇÕES - MEDIANA

try:
    cursor.close()
except Exception:
    pass

cursor = conn.cursor(buffered=True)

try:
    # baseada no teto de 112 projetos calculado anteriormente
    query_calculo_projetos_volume = """
        SELECT
            d.fk_deputado,
            CASE
                -- REGRA A: Menos de 5% da mediana (112 * 0.05 = 5.6 -> 5 projetos ou menos)
                -- Volume insignificante: a nota de projetos cai direto para 0.0
                WHEN IFNULL(d.qtde_proposicoes, 0) <= 5 THEN 0.0

                -- REGRA B: Produção abaixo da Mediana (Entre 6 e 111 projetos)
                -- Multiplica a nota de projetos original pela fração do volume que ele de fato entregou
                WHEN d.qtde_proposicoes < 112 THEN
                    IFNULL(d.score_projetos, 0.0) * (d.qtde_proposicoes / 112.0)

                -- REGRA C: Produção Estável/Plena (112 projetos ou mais)
                -- Atingiu a meta da metade mais produtiva da casa: mantém a nota intacta
                ELSE IFNULL(d.score_projetos, 0.0)
            END AS score_projetos_ponderado
        FROM Lumina2.desempenho d;
    """

    print("analisando nota de proposições com base na Mediana da Casa (112)...")
    cursor.execute(query_calculo_projetos_volume)
    resultados_projetos = cursor.fetchall()

    query_update_projetos = """
        UPDATE Lumina2.desempenho
        SET score_projetos = %s
        WHERE fk_deputado = %s
    """

    lote_updates = []
    for fk_deputado, score_projetos_ponderado in resultados_projetos:
        # Garante o limite estatístico rigoroso entre 0.0 e 1.0
        nota_limpa = max(0.0, min(1.0, float(score_projetos_ponderado)))
        lote_updates.append((nota_limpa, fk_deputado))

    if lote_updates:
        print(f"Atualizando a coluna 'score_projetos' para {len(lote_updates)} deputados...")
        cursor.executemany(query_update_projetos, lote_updates)
        conn.commit()
        print("coluna score_projetos corrigida")
    else:
        print("Nenhum registro modificado.")

except mysql.connector.Error as erro:
    print(f"[ERRO]: {erro}")
    conn.rollback()
finally:
    cursor.close()
