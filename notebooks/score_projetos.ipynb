try:
    # ETAPA 1: ATUALIZAÇÃO DO SCORE_PROJETOS

    query_update_score = """
        UPDATE Lumina2.proposicao_deputados
        INNER JOIN Lumina2.proposicoes
            ON proposicao_deputados.fk_proposicao = proposicoes.cd_proposicoes
        LEFT JOIN Lumina2.tipo_peso
            ON proposicoes.fk_tipo = tipo_peso.cd_tipo
        LEFT JOIN Lumina2.tema_proposicoes
            ON proposicoes.cd_proposicoes = tema_proposicoes.id_proposicao
        LEFT JOIN Lumina2.tema_peso
            ON tema_proposicoes.id_tema = tema_peso.cd_tema
        SET proposicao_deputados.score_projetos = (
            (IFNULL(tema_peso.peso, 0.1) * 0.4) +
            (IFNULL(tipo_peso.peso, 0.1) * 0.3) +
            (IFNULL(proposicoes.peso_status, 0.1) * 0.2) +
            (IFNULL(proposicao_deputados.peso, 0.5) * 0.1)
        );
    """

    print("1/3 -> Atualizando score_projetos na tabela proposicao_deputados...")
    cursor.execute(query_update_score)
    linhas_projetos = cursor.rowcount
    conn.commit()
    print(f"Sucesso! {linhas_projetos} linhas atualizadas em proposicao_deputados.")

    #CALCULAR A MÉDIA DOS PROJETOS PARA A TABELA DESEMPENHO
    query_media_projetos = """
        SELECT
            fk_deputado,
            IFNULL(AVG(score_projetos), 0.0) AS media_score
        FROM Lumina2.proposicao_deputados
        WHERE fk_deputado IS NOT NULL
        GROUP BY fk_deputado
    """

    print("\n2/3 -> Calculando médias dos projetos por deputado...")
    cursor.execute(query_media_projetos)
    lista_medias = cursor.fetchall()

    query_update_desempenho_projetos = """
        UPDATE Lumina2.desempenho
        SET score_projetos = %s
        WHERE fk_deputado = %s
    """

    dados_medias = []
    for fk_deputado, media_score in lista_medias:
        # Garante que o valor fique entre 0.0 e 1.0
        nota_limpa = max(0.0, min(1.0, float(media_score)))
        dados_medias.append((nota_limpa, fk_deputado))

    if dados_medias:
        cursor.executemany(query_update_desempenho_projetos, dados_medias)
        conn.commit()
        print(f"Sucesso! Médias salvas para {len(dados_medias)} deputados em desempenho.")

    #CALCULAR E ATUALIZAR O SCORE FINAL DO DEPUTADO
    query_calculo_final = """
        SELECT
            fk_deputado,
            (0.2 * IFNULL(score_presenca, 0.0)) +
            (0.2 * IFNULL(score_gastos, 0.0)) +
            (0.6 * IFNULL(score_projetos, 0.0)) AS resultado_final
        FROM Lumina2.desempenho
    """

    print("\n3/3 -> Calculando o Score Final ponderado em desempenho...")
    cursor.execute(query_calculo_final)
    lista_finais = cursor.fetchall()

    query_update_final = """
        UPDATE Lumina2.desempenho
        SET score_final = %s
        WHERE fk_deputado = %s
    """

    dados_finais = []
    for fk_deputado, resultado_final in lista_finais:
        nota_final_limpa = max(0.0, min(1.0, float(resultado_final)))
        dados_finais.append((nota_final_limpa, fk_deputado))

    if dados_finais:
        cursor.executemany(query_update_final, dados_finais)
        conn.commit()
        print(f"Sucesso! score_final atualizado para os deputados.")

    print("\n[PIPELINE EXECUTADO COM SUCESSO!]")

except mysql.connector.Error as erro:
    print(f"\n[ERRO DE BANCO DE DADOS]: {erro}")
    conn.rollback()
except Exception as e:
    print(f"\n[ERRO NO SCRIPT]: {e}")
